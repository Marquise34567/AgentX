# AgentX environment variables
# Copy this file to .env and fill in your values

# --- Postiz (self-hosted scheduler) ---
# Get these from your self-hosted Postiz instance:
#   1. Deploy Postiz: https://railway.com/deploy/postiz-with-temporal
#   2. Go to Settings → API → generate API key
#   3. Set the URL below to your Postiz instance URL + /public/v1
POSTIZ_API_KEY=
POSTIZ_BASE_URL=https://your-postiz-instance.up.railway.app/public/v1

# --- Optional: AI rewrites (BYOK) ---
# Only needed if you want LLM-powered rewrites. The copywriter engine works without this.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# AGENTX_MODEL=gpt-4o

# --- Server ---
PORT=3000

# --- Learning worker ---
# Set to "true" to disable the background learning worker
# DISABLE_WORKER=true
