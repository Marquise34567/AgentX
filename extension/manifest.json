{
  "manifest_version": 3,
  "name": "AgentX — X Engagement Engine",
  "version": "1.0.1",
  "description": "Generate scroll-stopping X posts from any topic. Graded on the real 2026 X algorithm.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open AgentX"
  }
}
